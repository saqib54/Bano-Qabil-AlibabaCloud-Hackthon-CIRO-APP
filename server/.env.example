# ============================================
# CIRO Backend Environment Variables
# ============================================

PORT=5000
NODE_ENV=development

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Google OAuth (Google Identity Services) client id; leave empty for demo-mode Google login
GOOGLE_CLIENT_ID=

# Database (SQLite file used in development; PostgreSQL-compatible design)
DATABASE_PATH=./database/ciro.sqlite

# Alibaba Cloud Model Studio / Qwen
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_TEXT_MODEL=qwen-plus
QWEN_VISION_MODEL=qwen-vl-plus

# Weather
WEATHER_API_KEY=

# Alibaba Cloud OSS (local /uploads fallback is used when unset)
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=

# CORS
FRONTEND_URL=http://localhost:5173

# Email OTP delivery (any SMTP provider; empty = dev-mode code echo)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@gmail.com
SMTP_PASS=<16-char Gmail app password>
SMTP_FROM=CIRO Emergency <your-account@gmail.com>

# Firebase project id for real Google sign-in popup
FIREBASE_PROJECT_ID=alibaba-cloud-hackthon

# Google Maps Platform key — geocoding for the Weather page radar map (optional)
GOOGLE_MAPS_API_KEY=

# Optional point-forecast provider key (reserved)
POINT_FORECAST_API_KEY=kB7ew13mZszZkRolDApCGgbqtStldVL6
